# Public site origin, without trailing path. Used for canonical, sitemap, Open Graph.
# User page:  https://username.github.io
# Project:    https://username.github.io  (path goes into BASE_PATH)
SITE_URL=https://localhost:4321

# GitHub Pages project sites need a subpath, e.g. /tea-guide/
# User/organization pages and custom domains use /
BASE_PATH=/
