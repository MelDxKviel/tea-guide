---
import { t, sourceCountLabel } from '../i18n';
import { formatDuration } from '../lib/brewing/calculate';
import type { BrewingRecipe } from '../lib/brewing/types';

interface Props {
  recipe: BrewingRecipe;
  methodLabel: string;
  note?: string;
}

const { recipe, methodLabel, note } = Astro.props;
const sourceCount = recipe.sourceRefs.length;
---

<section class="recipe-panel" data-recipe-id={recipe.id}>
  <div class="recipe-panel__label">
    <p class="kicker">{t('tea.baseRecipe')}</p>
    <p class="recipe-panel__method">{methodLabel}</p>
  </div>
  {
    note && <p class="recipe-panel__same">{note}</p>
  }
  <div class="recipe-panel__grid">
    <div class="stat">
      <dt>Лист / вода</dt>
      <dd>{recipe.referenceLeafGrams} г / {recipe.referenceVolumeMl} мл</dd>
    </div>
    {
      recipe.temperature && (
        <div class="stat">
          <dt>Температура</dt>
          <dd>
            {recipe.temperature.recommendedCelsius}°C
            {recipe.temperature.minCelsius && recipe.temperature.maxCelsius ? (
              <small class="meta-line">
                {' '}
                {t('brew.tempRange', {
                  min: recipe.temperature.minCelsius,
                  max: recipe.temperature.maxCelsius,
                })}
              </small>
            ) : null}
          </dd>
        </div>
      )
    }
    {
      recipe.vessel && (
        <div class="stat">
          <dt>Посуда</dt>
          <dd>{t(`brew.vessel.${recipe.vessel}`)}</dd>
        </div>
      )
    }
    {
      recipe.durationSeconds && (
        <div class="stat">
          <dt>Время</dt>
          <dd class="numeric">{formatDuration(recipe.durationSeconds)}</dd>
        </div>
      )
    }
  </div>

  {
    recipe.rinse && (
      <p>
        {t('timer.rinse')}: {recipe.rinse.durationSeconds} с
        {recipe.rinse.optional ? ' · можно пропустить' : ''}
        {recipe.rinse.note ? ` · ${recipe.rinse.note}` : ''}
      </p>
    )
  }

  {
    recipe.infusions && recipe.infusions.length > 0 && (
      <>
        <p class="infusion-steps__title">{t('tea.infusions')}</p>
        <ol class="infusion-steps">
          {recipe.infusions.map((item) => (
            <li>
              <span class="infusion-steps__n">{item.number}</span>
              <span class="infusion-steps__t">{item.durationSeconds} с</span>
            </li>
          ))}
        </ol>
      </>
    )
  }

  {recipe.notes?.map((item) => <p class="meta-line">{item}</p>)}

  <details class="details">
    <summary>{t('tea.recipeBySources')} · {sourceCountLabel(sourceCount)}</summary>
    <ul>
      {recipe.sourceRefs.map((ref) => (
        <li>
          <code>{ref.sourceId}</code>: {ref.supports.join(', ')}
        </li>
      ))}
    </ul>
  </details>
</section>
