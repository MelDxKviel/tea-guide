---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RecoveryBanner from '../components/RecoveryBanner.astro';
import { t } from '../i18n';
import { withBase } from '../lib/urls';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, ogType = 'website', jsonLd } = Astro.props;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : Astro.url.href;
const ogImage = site ? new URL(withBase('/og.png').replace(/^\//, ''), site).href : withBase('/og.png');
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#1d4536" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/icons/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <slot name="head" />
    {jsonLdItems.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <a class="skip-link" href="#content">{t('nav.skip')}</a>
    <RecoveryBanner />
    <Header currentPath={Astro.url.pathname} />
    <main id="content">
      <slot />
    </main>
    <Footer />
    <script>
      import { registerPwa } from '../scripts/pwa';
      import { hydrateChrome } from '../scripts/chrome';
      registerPwa();
      hydrateChrome();
    </script>
  </body>
</html>
